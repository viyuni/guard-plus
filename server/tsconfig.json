{
  "$schema": "https://www.schemastore.org/tsconfig",
  "include": ["src/**/*", "scripts/**/*", "package.json", "./env.d.ts", "*.config.ts"],
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun-types", "node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.app.tsbuildinfo",

    "paths": {
      "~/*": ["./*"],
      "#apps/*": ["./src/apps/*"],
      "#composition": ["./src/composition/index.ts"],
      "#composition/*": ["./src/composition/*"],
      "#config/*": ["./src/config/*"],
      "#infrastructure/*": ["./src/infrastructure/*"],
      "#modules/*": ["./src/modules/*"],
      "#shared": ["./src/shared/index.ts"],
      "#shared/*": ["./src/shared/*"],
      "#packages/schema/*": ["../packages/schema/src/*"],
      "#test-helpers/*": ["./src/__tests__/helpers/*"]
    }
  }
}
